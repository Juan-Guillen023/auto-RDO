# Copie para .env.local e preencha. O .env.local não vai para o git.

# Backend local (opcional). Sem ela, usa a produção no Render.
# É a BASE da API: as rotas (/gerar-rdo, /gerar-email...) são somadas a ela.
VITE_API_BASE=http://localhost:3001/api

# Supabase → Project Settings → API. As duas são públicas (seguras no navegador).
# NUNCA coloque aqui a chave "secret" / "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
