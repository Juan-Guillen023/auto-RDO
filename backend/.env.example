# Copie para .env e preencha. O .env não vai para o git.
# Em produção (Render), cadastre as mesmas variáveis em Environment.

# Chave da API do Gemini (geração de e-mail)
GEMINI_API_KEY=

# Mesmo projeto Supabase do frontend (Project Settings → API).
# Chave PÚBLICA: o backend só a usa para validar o login de quem chama.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Endereços do frontend autorizados a chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:5173,https://SEU-FRONTEND.vercel.app
